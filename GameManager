extends Node2D

@export var starting_goal: int
@onready var score_label: Label = $"../CanvasLayer/ScoreLabel"


signal result_ready(victory: bool)

var score: int = 0

func _ready() -> void:
	starting_goal = RunManager.round_count * 20

func _on_ball_scored() -> void:
	score += 1
	score_label.text = "Score: " + str(score)



func _on_canvas_layer_time_expired() -> void:
	if score >= starting_goal:
		print("VICTORY")
	else:
		print("DEFEAT")




func _on_ball_ball_at_rest() -> void:
	if score >= starting_goal:
		result_ready.emit(true)
	else:
		result_ready.emit(false)
