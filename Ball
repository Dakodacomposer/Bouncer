extends RigidBody2D


signal scored
signal ball_at_rest

var game_active: bool = false
var platform_active: bool = false
var waiting_for_rest: bool = false


func _ready() -> void:
	gravity_scale = RunManager.gravity_bonus

func _on_body_entered(body: Node) -> void:
	if body.name == "Platform" and game_active == true:
		scored.emit()



func _on_canvas_layer_game_started() -> void:
	freeze = false
	game_active = true


func _on_canvas_layer_time_expired() -> void:
	game_active = false
	waiting_for_rest = true



func _on_sleeping_state_changed() -> void:
	if waiting_for_rest and sleeping:
		ball_at_rest.emit()
