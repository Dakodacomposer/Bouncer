extends RigidBody2D


signal scored
signal ball_at_rest

var game_active: bool = false
var waiting_for_rest: bool = false


func _ready() -> void:
	gravity_scale = RunManager.gravity_bonus


func _on_body_entered(body: Node) -> void:
	if body.name == "Platform":
		if waiting_for_rest:
			linear_velocity = Vector2.ZERO
			freeze = true
			waiting_for_rest = false
			ball_at_rest.emit()
		elif game_active:
			scored.emit()


func _on_canvas_layer_game_started() -> void:
	freeze = false
	game_active = true


func _on_canvas_layer_time_expired() -> void:
	game_active = false
	waiting_for_rest = true
